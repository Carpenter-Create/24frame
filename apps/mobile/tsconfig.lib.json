{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["src/lib/**/*.ts", "src/lib/survivor-env.cjs", "src/lib/survivor-env.cjs.d.ts"],
  "exclude": ["src/lib/**/*.test.ts", "src/lib/supabase.ts"]
}
