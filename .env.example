# Public values only — never commit a real .env. Copy to .env.local and fill in.

# Supabase (local: from `supabase status`; prod: project settings)
# Survivor project only (uevsculwzwlhxeamagwg). Dashboard and @24frame/mobile
# both read these two names — do not add a second project or donor Auth env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (signup queue hygiene, not the security boundary).
# Dev: Cloudflare's documented "always passes" test keys
#   site   = 1x00000000000000000000AA
#   secret = 1x0000000000000000000000000000000AA
# Prod: real keys from a Cloudflare Turnstile widget (FOUNDER TASK — do not invent).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (money-in: tier subscriptions + fees). TEST mode for dev; live keys are a launch task.
#   secret sk_test_... ; publishable pk_test_... (public);
#   webhook secret whsec_... from: stripe listen --forward-to localhost:3000/api/stripe/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ask Globee free-text operator. Founder sets ANTHROPIC_API_KEY in Vercel
# (Sensitive, Production and Preview only). Never commit a real value.
ANTHROPIC_API_KEY=

# 24Frame finance AWS (dedicated namespace). Names only — never commit values.
# Never fall back to AWS_* (titles) or MEDIA_AWS_* (social). Never NEXT_PUBLIC_.
# Live buckets: 24frame-finance-dev / 24frame-finance-prod. CloudFront not yet.
FINANCE_AWS_REGION=
FINANCE_AWS_ACCESS_KEY_ID=
FINANCE_AWS_SECRET_ACCESS_KEY=
S3_FINANCE_BUCKET=
FINANCE_CLOUDFRONT_DOMAIN=
FINANCE_CLOUDFRONT_KEY_PAIR_ID=
FINANCE_CLOUDFRONT_PRIVATE_KEY=

# Live Aurora clusters: frame-aurora-dev / frame-aurora-prod (us-west-2).
# App still uses survivor Postgres until Secure Compute + cutover.
# Auth stays Supabase. Never a survivor pooler URL. Never NEXT_PUBLIC_.
AURORA_DATABASE_URL=
